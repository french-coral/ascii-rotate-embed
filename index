<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>culture — ascii</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&display=swap');

  :root{
    --paper:   #EFEDE7;
    --ink:     #23211E;
    --ink-soft:#4B4841;
    --accent:  #5B6B63;
    --line:    #D8D4CA;
  }

  *{ box-sizing: border-box; }

  html, body{
    margin:0; padding:0;
    width:100%; height:100%;
    background: var(--paper);
    color: var(--ink);
    font-family:'IBM Plex Mono', ui-monospace, Menlo, monospace;
    display:flex; align-items:center; justify-content:center;
    overflow:hidden;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
  }

  .stage{
    width: min(92vw, 420px);
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:22px;
  }

  .art-wrap{
    position:relative;
    width:100%;
    height:172px;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  pre.art{
    position:absolute;
    margin:0;
    font-size:13px;
    line-height:1.28;
    letter-spacing:0.5px;
    font-weight:300;
    color: var(--ink);
    text-align:center;
    white-space:pre;
    opacity:0;
    transform: translateY(6px) scale(0.985);
    transition: opacity 900ms cubic-bezier(.4,0,.2,1), transform 900ms cubic-bezier(.4,0,.2,1);
  }
  pre.art.active{
    opacity:1;
    transform: translateY(0) scale(1);
  }

  .rule{
    width:100%;
    height:1px;
    background: var(--line);
  }

  .caption-row{
    display:flex;
    align-items:baseline;
    justify-content:center;
    gap:10px;
    font-size:13px;
    letter-spacing:0.4px;
    color: var(--ink-soft);
    min-height: 18px;
  }

  #label{
    color: var(--accent);
    font-weight:500;
  }

  .cursor{
    display:inline-block;
    width:7px;
    height:14px;
    background: var(--accent);
    transform: translateY(2px);
    animation: blink 1.05s steps(1) infinite;
  }

  @keyframes blink{
    0%, 45%{ opacity:1; }
    46%, 100%{ opacity:0; }
  }

  .dots{
    display:flex;
    gap:7px;
  }
  .dots span{
    width:5px; height:5px;
    border-radius:50%;
    background: var(--line);
    transition: background 500ms ease;
  }
  .dots span.on{
    background: var(--accent);
  }
</style>
</head>
<body>

  <div class="stage">
    <div class="art-wrap" id="artWrap"></div>
    <div class="rule"></div>
    <div class="caption-row">
      <span>tracking</span>
      <span id="label"></span>
      <span class="cursor"></span>
    </div>
    <div class="dots" id="dots"></div>
  </div>

<script>
  const items = [
    {
      label: "film",
      art: `
        .-~~~-.
      .'  o o  \`.
     /   o   o   \\
    |  o       o  |
    |   o     o   |
     \\   o   o   /
      \`.  o o  .'
        \`-...-'  `
    },
    {
      label: "books",
      art: `

         ,   ,
        /////|
       ///// |
      |~~~|  |
      |===|  |
      |j  |  |
      | g |  |
      |  s| /
      |===|/
      '---'

`
    },
    {
      label: "music",
      art: `

       _________
     /           \\
    |   _______   |
    |  /       \\  |
    |  \\   o   /  |
    |   \\_____/   |
     \\           /
      \\_________/     `
    }
  ];

  const artWrap = document.getElementById('artWrap');
  const labelEl = document.getElementById('label');
  const dotsEl  = document.getElementById('dots');

  items.forEach(() => {
    const pre = document.createElement('pre');
    pre.className = 'art';
    artWrap.appendChild(pre);
  });
  items.forEach((_, i) => {
    const d = document.createElement('span');
    dotsEl.appendChild(d);
  });

  const artEls = artWrap.querySelectorAll('pre.art');
  const dotEls = dotsEl.querySelectorAll('span');

  let current = 0;

  function typeLabel(text){
    labelEl.textContent = '';
    let i = 0;
    const speed = 55;
    (function step(){
      if(i <= text.length){
        labelEl.textContent = text.slice(0, i);
        i++;
        setTimeout(step, speed);
      }
    })();
  }

  function show(index){
    artEls.forEach((el, i) => {
      el.textContent = items[i].art;
      el.classList.toggle('active', i === index);
    });
    dotEls.forEach((d, i) => d.classList.toggle('on', i === index));
    typeLabel(items[index].label);
  }

  show(current);

  setInterval(() => {
    current = (current + 1) % items.length;
    show(current);
  }, 3600);
</script>

</body>
</html>
